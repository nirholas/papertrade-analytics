{
  "name": "papertrade-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial live protocol analytics dashboard and JSON API for Papertrade (papertrade.xyz), the 1000x synthetic perps exchange on HyperEVM: TVL, volume, LP, open interest, markets, PAPER economics and leaderboard insights.",
  "license": "Apache-2.0",
  "author": "nirholas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/functions",
    "test": "vitest run",
    "test:live": "PAPERTRADE_LIVE=1 vitest run test/live.test.ts",
    "build:site": "esbuild site/app.ts --bundle --format=esm --minify --target=es2022 --sourcemap --outfile=site/public/app.js",
    "dev:site": "npm run build:site && cd site && wrangler pages dev --port 8791 --kv SNAPSHOTS",
    "deploy:site": "npm run build:site && cd site && wrangler pages deploy"
  },
  "keywords": [
    "papertrade",
    "hyperliquid",
    "hyperevm",
    "analytics",
    "dashboard",
    "defi",
    "perps",
    "lightweight-charts",
    "cloudflare-pages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/papertrade-analytics.git"
  },
  "homepage": "https://github.com/nirholas/papertrade-analytics#readme",
  "bugs": {
    "url": "https://github.com/nirholas/papertrade-analytics/issues"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "papertrade-sdk": "file:../papertrade-sdk-0.1.0.tgz",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
